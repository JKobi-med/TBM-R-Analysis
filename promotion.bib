  doi = {10.1016/j.tem.2003.08.003},
  abstract = {Recent discoveries have placed the insulin signalling pathways at the heart of the genetic control of longevity. An elegant new study of genes acting downstream of these signals in the nematode worm Caenorhabditis elegans reveals a plethora of information about the complex network of mechanisms that modulate the ageing process.},
